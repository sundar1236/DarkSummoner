# Auto detect text files and perform LF normalization on checkin
* text=auto eol=lf

# Godot scripts and text resources
*.gd text eol=lf
*.tscn text eol=lf merge=union
*.tres text eol=lf merge=union
*.godot text eol=lf
*.cfg text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.svg text
*.wav binary
*.ogg binary
*.mp3 binary
*.keystore binary
*.apk binary
*.aab binary
*.zip binary
*.bin binary
